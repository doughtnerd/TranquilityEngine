{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "stripInternal": true,
    "sourceMap": false,
    "rootDir": "./src",
    "outDir": "./dist/engine/types"
  },
  "include": ["src/myco.ts", "src/engine/**/*", "src/plugins/manifest.ts", "src/plugins/order.ts", "src/plugins/runtimeContext.ts", "src/plugins/*/manifest.ts", "src/plugins/*/runtime/**/*"],
  "exclude": ["src/engine/tests/**/*", "src/engine/editor/**/*", "src/plugins/**/*.test.ts", "src/plugins/**/*.bench.ts", "src/plugins/**/*Rig.ts"]
}
