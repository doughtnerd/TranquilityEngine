{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "ESNext.Decorators"],
    "types": ["vite/client"],
    "strict": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "useDefineForClassFields": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "skipLibCheck": true,
    "paths": { "myco": ["./src/myco.ts"], "myco/editor": ["./src/editor/sdk/index.ts"], "tranquility": ["./src/myco.ts"] },
    "sourceMap": true,
    "outDir": "./dist/"
  },
  "include": ["src/**/*", "samples/*/scripts/**/*"]
}
