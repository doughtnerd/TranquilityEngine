{
  "presets": [
    [
      "babel-preset-env",
      {
        "targets": {
          "browsers": [
            ">0.25%",
            "not ie 11",
            "not op_mini all"
          ]
        },
        "modules": false
      }
    ],
    ["@babel/preset-typescript", {
      "target": "es2020"
    }]
  ],
  "plugins": ["@babel/compat-data"],
}
