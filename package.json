{
  "name": "tranquility-engine",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "main": "./dist/engine/engine.js",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && npm run build:game && npm run build:editor && npm run build:engine",
    "build:game": "vite build",
    "build:editor": "vite build --config vite.editor.config.ts",
    "build:engine": "vite build --config vite.engine.config.ts && tsc -p tsconfig.engine.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium webkit",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:editor:dev": "tauri dev --config src-tauri/tauri.editor.conf.json",
    "tauri:editor:build": "tauri build --config src-tauri/tauri.editor.conf.json"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@dimforge/rapier2d-compat": "^0.21.0",
    "@preact/signals": "^2.11.4",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "howler": "^2.2.4",
    "monaco-editor": "^0.57.0",
    "preact": "^11.1.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/howler": "^2.2.13",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "typescript": "^5.0.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "types": "./dist/engine/types/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/engine/types/index.d.ts",
      "import": "./dist/engine/engine.js"
    }
  }
}
