{
  "name": "myco-engine",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "main": "./dist/engine/engine.js",
  "bin": {
    "myco-server": "src/server/cli.mjs"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && npm run build:editor && npm run build:engine",
    "build:player": "vite build --config vite.player.config.ts",
    "build:editor": "npm run check:filenames && npm run build:player && npm run build:rendezvous && vite build --config vite.editor.config.ts",
    "build:rendezvous": "vite build --config tools/rendezvous/vite.config.ts",
    "build:engine": "vite build --config vite.engine.config.ts && tsc -p tsconfig.engine.json",
    "preview": "vite preview --config vite.editor.config.ts",
    "server": "node src/server/cli.mjs",
    "export": "node src/export/cli.mjs",
    "nav:bake": "node src/nav-cli/cli.mjs",
    "rewrite": "node src/rewrite-cli/cli.mjs",
    "audio:migrate": "node src/migrate-cli/cli.mjs",
    "test": "vitest run",
    "test:tools": "node --test tools/*.test.mjs",
    "test:stories": "vitest run --config vitest.stories.config.mts",
    "test:svelte-conformance": "node tools/svelte-conformance/fetch.mjs && vitest run --config vitest.svelte-conformance.config.mts",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build -o dist/storybook",
    "bench": "vitest bench --run",
    "bench:memory": "node --expose-gc bench/memory.mjs",
    "build:nav": "node native/nav/build.mjs",
    "build:layout": "node native/layout/build.mjs",
    "build:input": "node native/input/build.mjs",
    "build:audio": "node native/audio/build.mjs",
    "build:anim": "node native/anim/build.mjs",
    "build:tween": "node native/tween/build.mjs",
    "check:audio-metered": "node tools/audio-bench/metered-gate.mjs",
    "bench:audio-spatial": "node tools/audio-bench/spatial.mjs",
    "check:links": "node tools/check-doc-links.mjs",
    "docs:wiki": "node tools/build-wiki.mjs",
    "bench:audio-events": "AUDIO_BENCH=1 vitest run src/plugins/audio/runtime/events/eventBench.test.ts --reporter=verbose",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:slow": "playwright test --project=chromium-slow",
    "test:e2e:chromium": "playwright test --project=chromium --project=chromium-slow",
    "test:e2e:webkit": "playwright test --project=webkit --project=webkit-slow",
    "test:e2e:all": "playwright test",
    "test:e2e:install": "playwright install chromium webkit",
    "typecheck": "npm run check:filenames && tsc --noEmit && tsc -p tsconfig.node.json",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:studio:dev": "node tools/tauri-studio.mjs dev",
    "tauri:studio:build": "node tools/tauri-studio.mjs build",
    "postinstall": "patch-package",
    "bench:particles": "node bench/particles/run.mjs",
    "bench:anim": "node tools/anim-bench/run.mjs",
    "bench:anim:babylon": "node tools/anim-bench/babylon.mjs",
    "check:filenames": "node tools/check-filename-case.mjs",
    "build:fx-examples": "node native/fx-sdk/build.mjs"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@babylonjs/core": "9.32.0",
    "@babylonjs/gui": "9.32.0",
    "@dimforge/rapier2d-compat": "^0.21.0",
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@preact/signals": "^2.11.4",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@xyflow/system": "0.0.84",
    "css-tree": "3.2.1",
    "esbuild-wasm": "0.28.2",
    "htmlparser2": "12.0.0",
    "monaco-editor": "^0.57.0",
    "node-datachannel": "^0.33.6",
    "preact": "^11.1.1",
    "resolve.exports": "2.0.4",
    "svelte": "5.59.2",
    "svelte2tsx": "0.7.63",
    "three": "^0.187.0",
    "ws": "^8.22.1",
    "yoga-layout": "3.2.1"
  },
  "devDependencies": {
    "@formatjs/icu-messageformat-parser": "^3.5.23",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-vitest": "10.6.7",
    "@storybook/preact-vite": "10.6.7",
    "@tauri-apps/cli": "^2.12.4",
    "@types/css-tree": "3.2.0",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "@types/ws": "^8.18.2",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "patch-package": "8.0.1",
    "sharp": "^0.35.5",
    "storybook": "10.6.7",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.1",
    "typescript": "^5.0.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "types": "./dist/engine/types/myco.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/engine/types/myco.d.ts",
      "import": "./dist/engine/engine.js"
    }
  }
}
