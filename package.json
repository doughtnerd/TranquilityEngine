{
  "name": "myco-engine",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "main": "./dist/engine/engine.js",
  "bin": {
    "myco-server": "src/server/cli.mjs"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && npm run build:editor && npm run build:engine",
    "build:player": "vite build --config vite.player.config.ts",
    "build:editor": "npm run build:player && vite build --config vite.editor.config.ts",
    "build:engine": "vite build --config vite.engine.config.ts && tsc -p tsconfig.engine.json",
    "preview": "vite preview --config vite.editor.config.ts",
    "server": "node src/server/cli.mjs",
    "export": "node src/export/cli.mjs",
    "nav:bake": "node src/nav-cli/cli.mjs",
    "test": "vitest run",
    "bench": "vitest bench --run",
    "bench:memory": "node --expose-gc bench/memory.mjs",
    "build:nav": "node native/nav/build.mjs",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium webkit",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "postinstall": "patch-package"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@babylonjs/core": "9.32.0",
    "@babylonjs/gui": "9.32.0",
    "@dimforge/rapier2d-compat": "^0.21.0",
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@pmndrs/uikit": "1.0.77",
    "@preact/signals": "^2.11.4",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@xyflow/system": "0.0.84",
    "css-tree": "3.2.1",
    "howler": "^2.2.4",
    "htmlparser2": "12.0.0",
    "monaco-editor": "^0.57.0",
    "n8ao": "2.0.1",
    "postprocessing": "6.39.6",
    "preact": "^11.1.1",
    "three": "^0.187.0",
    "three.quarks": "0.17.1",
    "ws": "^8.22.1",
    "yoga-layout": "3.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/css-tree": "3.2.0",
    "@types/howler": "^2.2.13",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "@types/ws": "^8.18.2",
    "patch-package": "8.0.1",
    "typescript": "^5.0.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "types": "./dist/engine/types/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/engine/types/index.d.ts",
      "import": "./dist/engine/engine.js"
    }
  }
}
