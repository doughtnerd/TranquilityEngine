<!--
  Flappy's HUD as a UI document (ADR 0077): the score, the ready / game over message and the music
  readout. The look is in hud.ui.css; scripts/behaviors/GameManager.ts fills the {bindings}.
-->
<Canvas>
  <Style src="hud.ui.css"/>
  <Text id="score">{score}</Text>
  <Text id="message">{message}</Text>
  <Text id="music">{music}</Text>
</Canvas>
