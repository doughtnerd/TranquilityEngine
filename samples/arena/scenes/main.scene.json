      "transform": false,
      "components": [
        { "type": "engine.Text", "data": { "text": "[H]  Host a game", "anchor": "center", "offset": [0, 10], "fontSize": 34, "color": "#ffffff" } }
      ]
    },
    {
      "id": "join",
      "name": "JoinButton",
      "transform": false,
      "components": [
        { "type": "engine.Text", "data": { "text": "[J]  Join ws://localhost:7777", "anchor": "center", "offset": [0, 70], "fontSize": 34, "color": "#ffffff" } }
      ]
    },
    {
      "id": "status",
      "name": "Status",
      "transform": false,
      "components": [
        {
          "type": "engine.Text",
          "data": { "text": "Press a key to choose", "anchor": "bottom", "offset": [0, -70], "fontSize": 20, "fontWeight": "400", "color": "#9aa0ad" }
