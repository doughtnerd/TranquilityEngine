<!--
  The arena's menu as a UI document (ADR 0077): the title, the two choices and a status line.
  The look is in menu.ui.css; scripts/behaviors/Menu.ts fills the {bindings}.
-->
<Canvas>
  <Style src="menu.ui.css"/>
  <Text id="title">ARENA</Text>
  <Text id="subtitle">a two-player netcode sample</Text>
  <Panel id="choices">
    <Text class="choice">[H]  Host a game</Text>
    <Text class="choice">{join}</Text>
  </Panel>
  <Text id="status">{status}</Text>
</Canvas>
