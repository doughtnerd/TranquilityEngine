{
  "format": "myco.scene@2",
  "settings": { "physics": "3d" },
  "nodes": [
    {
      "id": "camera",
      "name": "Camera",
      "components": [
        { "type": "engine.Transform", "data": { "position": [0, 5, 12], "rotation": [-20, 0, 0] } },
        { "type": "engine.Camera", "data": { "projection": "perspective", "fieldOfView": 55 } },
        { "type": "engine.AudioListener", "data": {} }
      ]
    },
    {
      "id": "sun",
      "name": "Sun",
      "components": [
        { "type": "engine.Transform", "data": { "position": [0, 8, 0], "rotation": [-55, 35, 0] } },
        { "type": "engine.Light", "data": { "type": "directional", "intensity": 1.4 } }
      ]
    },
    {
      "id": "music",
      "name": "Music",
      "transform": false,
      "components": [
        {
          "type": "engine.AudioSource",
          "data": { "clip": "asset:audio/music-loop.wav", "loop": true, "volume": 0.5, "playOnAwake": true, "output": "Music" }
        },
        { "type": "lab.PauseToggle", "data": { "key": "p" } }
      ]
    },
    {
      "id": "emitter",
      "name": "Emitter",
      "components": [
        { "type": "engine.Transform", "data": { "position": [6, 1, 0] } },
        { "type": "engine.MeshRenderer", "data": { "mesh": "builtin:sphere" } },
        {
          "type": "engine.AudioSource",
          "data": {
            "clip": "asset:audio/hum-loop.wav",
            "loop": true,
            "volume": 0.4,
            "playOnAwake": true,
            "spatial": true,
            "minDistance": 2,
            "maxDistance": 30,
            "output": "Ambience",
            "dopplerLevel": 0
          }
        },
        { "type": "lab.Orbit", "data": { "radius": 6, "speed": 0.25 } }
      ]
    },
    {
      "id": "events",
      "name": "Events page (key E)",
      "transform": false,
      "components": [{ "type": "lab.SceneSwitch", "data": { "key": "e", "scene": "scenes/events.scene.json" } }]
    },
    {
      "id": "spatial",
      "name": "Spatial page (key S)",
      "transform": false,
      "components": [{ "type": "lab.SceneSwitch", "data": { "key": "s", "scene": "scenes/spatial.scene.json" } }]
    },
    {
      "id": "oneshots",
      "name": "OneShots (key 1)",
      "transform": false,
      "components": [{ "type": "lab.OneShots", "data": {} }]
    },
    {
      "id": "buses",
      "name": "Buses (keys 2, 3)",
      "transform": false,
      "components": [{ "type": "lab.Buses", "data": {} }]
    },
    {
      "id": "snapshots",
      "name": "Snapshots (key 4)",
      "transform": false,
      "components": [{ "type": "lab.Snapshots", "data": {} }]
    },
    {
      "id": "effects",
      "name": "Effects (keys 5, 6)",
      "transform": false,
      "components": [{ "type": "lab.Effects", "data": {} }]
    },
    {
      "id": "bench",
      "name": "Listening bench (keys 7, 8, 9, 0, Q, O, I, K)",
      "transform": false,
      "components": [{ "type": "lab.ListeningBench", "data": {} }]
    },
    {
      "id": "tape",
      "name": "Tape (keys T, Y, U)",
      "transform": false,
      "components": [
        {
          "type": "engine.AudioSource",
          "data": { "clip": "asset:audio/melody-loop.wav", "loop": true, "volume": 0.7, "playOnAwake": false, "output": "Tape" }
        },
        { "type": "lab.Tape", "data": {} },
        { "type": "lab.PauseToggle", "data": { "key": "u" } }
      ]
    },
    {
      "id": "loops",
      "name": "Loops (key G)",
      "transform": false,
      "components": [
        {
          "type": "engine.AudioSource",
          "data": { "clip": "asset:audio/loops/loop.wav", "loop": true, "volume": 0.7, "playOnAwake": false, "output": "UI" }
        },
        { "type": "lab.LoopCycler", "data": {} }
      ]
    },
    {
      "id": "crowd1",
      "name": "Crowd 1 (key H)",
      "components": [
        { "type": "engine.Transform", "data": { "position": [3, 5, 12] } },
        { "type": "engine.MeshRenderer", "data": { "mesh": "builtin:sphere" } },
        {
          "type": "engine.AudioSource",
          "data": { "clip": "asset:audio/noise-loop.wav", "loop": true, "volume": 0.5, "playOnAwake": false, "spatial": true, "minDistance": 2, "maxDistance": 30, "dopplerLevel": 0 }
        },
        { "type": "lab.Orbit", "data": { "radius": 3, "speed": 0.1, "phase": 0, "centerX": 0, "centerZ": 12 } },
        { "type": "lab.Toggle", "data": { "key": "h" } }
      ]
    },
    {
      "id": "crowd2",
      "name": "Crowd 2 (key J)",
      "components": [
        { "type": "engine.Transform", "data": { "position": [7, 4, 12] } },
        { "type": "engine.MeshRenderer", "data": { "mesh": "builtin:sphere" } },
        {
          "type": "engine.AudioSource",
          "data": { "clip": "asset:audio/noise-loop.wav", "loop": true, "volume": 0.5, "playOnAwake": false, "spatial": true, "minDistance": 2, "maxDistance": 30, "dopplerLevel": 0 }
        },
        { "type": "lab.Orbit", "data": { "radius": 7, "speed": -0.18, "phase": 0.33, "centerX": 0, "centerZ": 12 } },
        { "type": "lab.Toggle", "data": { "key": "j" } }
      ]
    },
    {
      "id": "crowd3",
      "name": "Crowd 3 (key J)",
      "components": [
        { "type": "engine.Transform", "data": { "position": [11, 6, 12] } },
        { "type": "engine.MeshRenderer", "data": { "mesh": "builtin:sphere" } },
        {
          "type": "engine.AudioSource",
          "data": { "clip": "asset:audio/noise-loop.wav", "loop": true, "volume": 0.5, "playOnAwake": false, "spatial": true, "minDistance": 2, "maxDistance": 30, "dopplerLevel": 0 }
        },
        { "type": "lab.Orbit", "data": { "radius": 11, "speed": 0.27, "phase": 0.66, "centerX": 0, "centerZ": 12 } },
        { "type": "lab.Toggle", "data": { "key": "j" } }
      ]
    }
  ]
}
