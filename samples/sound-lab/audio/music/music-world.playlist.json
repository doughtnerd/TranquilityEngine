  "switch": {
    "parameter": "State",
    "map": {
      "explore": 0,
      "combat": 1,
      "calm": 2
    },
    "onChange": {
      "when": "bar",
      "how": "crossfade",
      "length": {
        "beats": 1
      }
    },
    "rules": [
      {
        "from": "explore",
        "to": "combat",
        "when": "bar",
        "how": "cut",
        "length": {
          "beats": 0
        }
      },
      {
        "from": "combat",
        "to": "explore",
        "when": "bar",
        "how": "crossfade",
        "length": {
          "beats": 2
        }
      },
      {
        "from": "explore",
        "to": "calm",
        "when": "bar",
        "how": "crossfade",
        "length": {
          "beats": 4
        },
        "shapeOut": "linear",
        "shapeIn": "linear"
      },
      {
        "from": "calm",
        "to": "explore",
        "when": "bar",
        "how": "crossfade",
        "length": {
          "beats": 4
        },
        "shapeOut": "sCurve",
        "shapeIn": "sCurve"
      },
      {
        "from": "calm",
        "to": "combat",
        "when": "bar",
        "how": "transition",
        "length": {
          "beats": 1
        },
        "transition": {
          "embedded": {
            "type": "sequence",
            "entries": [],
            "sequence": {
              "length": 2,
              "tempo": {
                "bpm": 120,
                "meter": "4/4"
              },
              "tracks": [
                {
                  "id": "t1",
                  "name": "riser",
                  "kind": "audio",
                  "color": 1,
                  "clips": [
                    {
                      "id": "t1c1",
                      "sample": "audio/music/bridge-riser.wav",
                      "at": 0,
                      "length": 2,
                      "sync": true
                    }
                  ]
                }
              ],
              "markers": [
                {
                  "id": "m1",
                  "name": "exit",
                  "at": 2,
                  "type": "exit"
                }
              ]
            }
          }
        },
        "transitionIn": {
          "length": {
            "beats": 0
          },
          "shape": "equalPower"
        },
        "transitionOut": {
          "length": {
            "beats": 0
          },
          "shape": "equalPower"
        }
      }
    ]
  }
