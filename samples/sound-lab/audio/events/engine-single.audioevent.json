{
  "format": "myco.audioevent@1",
  "bus": "Engine",
  "priority": 160,
  "limit": { "maxInstances": 1, "steal": "oldest" },
  "parameters": [{ "name": "RPM", "min": 0, "max": 1, "default": 0, "seekSpeed": 1.5 }],
  "automation": [
    { "parameter": "RPM", "target": "pitch", "curve": [[0, 0.9], [1, 1.3]] },
    { "parameter": "RPM", "target": "volume", "curve": [[0, 0.6], [1, 1]] }
  ],
  "root": {
    "type": "clip",
    "clip": "audio/events/engine-single.wav",
    "sustain": true,
    "loopRegion": [0.5, 1.5]
  }
}
