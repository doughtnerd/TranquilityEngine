{
  "format": "myco.audioevent@1",
  "bus": "Music",
  "priority": 200,
  "limit": { "maxInstances": 1, "steal": "oldest" },
  "root": {
    "type": "segment",
    "id": "intensity",
    "gridOffset": 0,
    "tempo": [{ "at": "1:1:0", "bpm": 120, "beatsPerBar": 4, "beatUnit": 4 }],
    "cues": [
      { "name": "entry", "at": "1:1:0" },
      { "name": "exit", "at": "end" }
    ],
    "entry": "entry",
    "exit": "exit",
    "regions": [{ "id": "loop", "from": "1:1:0", "to": "end", "count": 0 }],
    "tracks": [
      { "name": "pad", "clip": "audio/events/music-pad.wav", "volume": 0.8 },
      {
        "name": "pulse",
        "clip": "audio/events/music-pulse.wav",
        "automation": [{ "parameter": "Intensity", "target": "volume", "curve": [[0.2, 0], [0.6, 1]] }]
      },
      {
        "name": "lead",
        "clip": "audio/events/music-lead.wav",
        "automation": [{ "parameter": "Intensity", "target": "volume", "curve": [[0.6, 0], [1, 1]] }]
      }
    ]
  }
}
