<!--
  The Sound Lab's mixer page text as a UI document (ADR 0077): the page's heading lines and its readouts.
  The look is in lab.ui.css, shared by every page; the scripts on the scene's nodes fill the {bindings}.
-->
<Canvas>
  <Style src="lab.ui.css"/>
  <Panel id="hud">
    <Text class="title">Sound Lab: mixer (B goes back to the tour)</Text>
    <Text class="title">Click the game view first. Music and an ambience bed play; the voice and bursts duck them.</Text>
    <Text id="mixer" class="readout">{mixer}</Text>
    <Text id="loudness" class="readout">{loudness}</Text>
  </Panel>
</Canvas>
