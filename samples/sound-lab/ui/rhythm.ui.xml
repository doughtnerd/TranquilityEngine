<!--
  The Sound Lab's rhythm page text as a UI document (ADR 0077): the page's heading lines and its readouts.
  The look is in lab.ui.css, shared by every page; the scripts on the scene's nodes fill the {bindings}.
-->
<Canvas>
  <Style src="lab.ui.css"/>
  <Panel id="hud">
    <Text class="title">Sound Lab: rhythm (B goes back to the tour)</Text>
    <Text class="title">Click the game view first. Tap SPACE or press the view: C calibrates on a click track, G is the tap game.</Text>
    <Text id="rhythm" class="readout">{rhythm}</Text>
  </Panel>
</Canvas>
