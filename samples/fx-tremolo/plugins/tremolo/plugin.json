{
  "name": "example.tremolo",
  "version": "1.0.0",
  "sdk": "^1.0.0",
  "title": "Tremolo",
  "description": "The reference audio effect plugin: a tremolo written in Rust on the myco-fx SDK (ADR 0352).",
  "audio": {
    "abi": 1,
    "modules": { "dsp": { "wasm": "dsp/tremolo.wasm", "memoryMB": 1 } },
    "effects": [
      {
        "type": "example.tremolo",
        "module": "dsp",
        "kind": 0,
        "label": "Tremolo",
        "version": "1.0.0",
        "levels": ["sample", "instance", "bus"],
        "cost": "light",
        "budget": { "instructionsPerFrame": 300 },
        "maxInstances": 32,
        "params": [
          { "name": "rate", "label": "Rate", "min": 0.1, "max": 20, "step": 0.01, "unit": "Hz", "default": 5, "scale": "log" },
          { "name": "depth", "label": "Depth", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50, "scale": "linear" },
          { "name": "shape", "label": "Shape", "choices": ["Sine", "Triangle", "Square"], "default": 0, "smooth": false }
        ]
      }
    ]
  }
}
