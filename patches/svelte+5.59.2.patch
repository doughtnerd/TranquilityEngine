@@ -0,0 +1,28 @@
+/** @import { Renderer } from './types.js' */
+import { render_effect } from '../reactivity/effects.js';
+import * as e from '../errors.js';
+import { current_renderer } from './state.js';
+
+/**
+ * An element binding (`bind:value`, `bind:checked`, `bind:clientWidth`...) under a custom renderer:
+ * the renderer's `bind(node, name, get, set)` hook connects the node to the bound state and returns
+ * a cleanup function. Like an attachment, the hook runs again (after the previous cleanup) when state
+ * it read through `get()` changes, so a renderer pushes the current value by reading `get()` and
+ * reports changes from the node by calling `set(value)`.
+ *
+ * The compiler can't see the renderer object, so a renderer without `bind` fails here, when the
+ * binding is created, rather than at compile time.
+ * @param {unknown} node
+ * @param {string} name
+ * @param {() => unknown} get
+ * @param {(value: unknown) => void} [set]
+ */
+export function bind_renderer(node, name, get, set = get) {
+	var renderer = /** @type {Renderer<any> | null} */ (current_renderer);
+
+	if (typeof renderer?.bind !== 'function') {
+		e.renderer_bind_unsupported(name);
+	}
+
+	render_effect(() => renderer.bind(node, name, get, set));
+}
