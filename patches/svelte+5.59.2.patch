+/** @import { Renderer } from './types.js' */
+import * as e from '../errors.js';
+import { pop_renderer, push_renderer } from './state.js';
+
+/**
+ * The animations a custom renderer runs (or holds, with `fill: 'forwards'`) on each node until they're
+ * cancelled: what `element.getAnimations()` reports in the DOM
+ * @type {WeakMap<object, Set<any>>}
+ */
+var running = new WeakMap();
+
+/**
+ * Throws unless `renderer` can run transitions and animations (its optional `animate` hook) and, for
+ * `animate:`, measure nodes (its `measure` hook). Called when the transition or animation is created,
+ * since the compiler can't see the renderer object.
+ * @param {Renderer<any>} renderer
+ * @param {'transition' | 'in' | 'out' | 'animate'} directive
+ */
+export function require_animate(renderer, directive) {
+	if (typeof renderer.animate !== 'function') {
+		e.renderer_animate_unsupported(directive);
+	}
+
+	if (directive === 'animate' && typeof renderer.measure !== 'function') {
+		e.renderer_measure_unsupported(directive);
+	}
+}
+
+/**
+ * `element.animate(keyframes, options)` under a custom renderer: the renderer's `animate` hook runs the
+ * keyframes on its node and returns a handle (`cancel()`, `currentTime`, `onfinish`, and `onframe`, which
+ * the renderer calls on each of its frames while the animation runs)
+ * @param {Renderer<any>} renderer
+ * @param {any} node
+ * @param {Keyframe[]} keyframes
+ * @param {{ duration: number, fill: 'forwards' }} options
+ * @returns {any}
+ */
+export function renderer_animate(renderer, node, keyframes, options) {
+	var animation = /** @type {any} */ (renderer.animate)(node, keyframes, options);
+	var set = running.get(node);
+	if (set === undefined) running.set(node, (set = new Set()));
+	set.add(animation);
+
+	var cancel = animation.cancel;
+	animation.cancel = function () {
+		set?.delete(animation);
+		return cancel.call(this);
+	};
+
+	return animation;
+}
+
+/**
+ * Whether a custom renderer's node has animations running or held (`element.getAnimations().length`)
+ * @param {object} node
+ */
+export function has_renderer_animations(node) {
+	return (running.get(node)?.size ?? 0) > 0;
+}
+
+/**
+ * Runs `fn` with `renderer` as the current renderer, so that a transition function (`fade`, `flip`...)
+ * called after its component was created (in a microtask, or when an outro starts) measures nodes through
+ * it (`svelte/transition` and `svelte/animate` read geometry with `computed_style` and `bounding_rect`).
+ * With `null`, `fn` just runs.
+ * @template T
+ * @param {Renderer<any> | null} renderer
+ * @param {() => T} fn
+ * @returns {T}
