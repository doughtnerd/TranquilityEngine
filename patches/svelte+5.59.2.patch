+ */
+export function renderer_bind_unsupported(name) {
+	if (DEV) {
+		const error = new Error(`renderer_bind_unsupported\n\`bind:${name}\` needs the custom renderer to define \`bind\`\nhttps://svelte.dev/e/renderer_bind_unsupported`);
+
+		error.name = 'Svelte error';
+
+		throw error;
+	} else {
+		throw new Error(`https://svelte.dev/e/renderer_bind_unsupported`);
+	}
+}
