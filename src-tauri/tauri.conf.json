{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Myco Engine",
  "version": "0.1.0",
  "identifier": "com.foxfirestudios.myco.editor",
  "build": {
    "frontendDist": "../dist/editor",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:editor"
  },
  "app": {
    "windows": [
      {
        "label": "projects",
        "title": "Myco Engine",
        "url": "projects.html",
        "width": 610,
        "height": 700,
        "center": true,
        "resizable": false,
        "decorations": false,
        "shadow": true,
        "transparent": false
      },
      {
        "label": "main",
        "title": "Myco Engine · Editor",
        "url": "editor.html",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "create": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
